    },
    {
      "assetPattern": "^Handy_.*_amd64\\.AppImage$",
      "format": "AppImage (Tauri)",
      "id": "handy-appimage",
      "includePrerelease": false,
      "repo": "cjpais/Handy"
    },
    {
      "assetPattern": "^pot_.*_amd64\\.AppImage$",
      "format": "AppImage (Tauri)",
      "id": "pot-appimage",
      "includePrerelease": false,
      "repo": "pot-app/pot-desktop"
