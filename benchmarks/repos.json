    {
      "assetPattern": "^Paseo-x86_64\\.AppImage$",
      "format": "AppImage (Electron)",
      "id": "paseo-appimage",
      "includePrerelease": false,
      "repo": "getpaseo/paseo"
    },
    {
      "assetPattern": "^Paseo-[0-9.]+-arm64\\.zip$",
